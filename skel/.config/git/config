[user]
    name = Lucas Wilson
    email = lukey.dubs@gmail.com

[alias]
    ; helpers
    branch-name = rev-parse --abbrev-ref HEAD

    ; git everything
    st = status -sb
    f = fetch --tags --all --prune
    s = !git f && git st

    ; log
    l = log --decorate --oneline --graph --format='%C(auto)%h <%an@%ar> %d %s'
    lr = log --decorate --oneline --graph --format='%C(auto)%h <%an@%ar> %d %s' HEAD @{u}
    lh = !git l --color=always --format='%C(auto)%h <%an@%ar> %d %s' | head
    la = log --decorate --oneline --graph --format='%C(auto)%h <%an@%ar> %d %s' --all
    lref = log --decorate --oneline --graph --format='%C(auto)%h <%an@%ar> %d %s' --reflog

    ; branch
    c = checkout
    cb = checkout -b
    b = branch -vv
    br = branch -r
    bu = !git branch -u origin/$(git branch-name)

    ; pushing
    p = push
    po = !git p -u origin $(git branch-name)

    ; commits
    a = add -A
    cm = "!_gfn() { git commit -m \"$*\"; }; _gfn"
    ca = commit --amend

    ; diff
    d = diff
    dc = diff --cached
    ds = diff --stat
    dr = diff @{u}

    ; remote
    rv = remote -v

[core]
    ; Normalize new text to LF on add; preserve existing CRLF during normal adds.
    ; Leave checkout endings unchanged, including on Windows.
    autocrlf = input

[init]
    defaultBranch = main
