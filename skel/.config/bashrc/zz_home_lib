if type tmux >&/dev/null; then
  # This uses a session name derived from path. Outside tmux, it attaches to an
  # existing workspace or makes a new one. From a non-ws server, it creates the
  # workspace on the ws server without leaving the current session. Inside the
  # ws server, it switches the current client to that workspace and closes the
  # pane it came from.
  th() {
    workspace_id="ws-$(printf %s "$PWD" | shasum | cut -c1-12)"
    if [ -n "$TMUX" ]; then
      case "$TMUX" in
        */ws,*)
          ;;
        *)
          if ! tmux -L ws has-session -t "=$workspace_id" 2>/dev/null; then
            tmux -L ws new-session -d -s "$workspace_id" || return
          fi
          printf 'th: current tmux server is not ws; %s is ready in ws\n' \
            "$workspace_id" >&2
          return
          ;;
      esac

      current_session=$(tmux -L ws display-message -p '#{session_name}')
      if [ "$current_session" = "$workspace_id" ]; then
        return
      fi

      current_pane=$(tmux -L ws display-message -p '#{pane_id}')
      tmux -L ws has-session -t "=$workspace_id" 2>/dev/null ||
        tmux -L ws new-session -d -s "$workspace_id"
      tmux -L ws switch-client -t "=$workspace_id" &&
        tmux -L ws kill-pane -t "$current_pane"
    else
      tmux -L ws new-session -A -s "$workspace_id"
    fi
  }
  # this creates a new tmux server and creates a session within it. it is also
  # scoped to the current directory. it also uses a custom config to allow ctrl
  # j/k bindings to move between windows.
  tt() {
    workspace_id="ws-$(printf %s "$PWD" | shasum | cut -c1-12)"
    tmux -L "$workspace_id" -f "$HOME/.config/tmux/tmux-inner.conf" new-session -A -s ws
  }
fi

# clip: pipe stdin to the system clipboard, cross-platform and SSH-aware.
#
#   some-command | clip
#
# Local sessions use the native clipboard tool (macOS pbcopy, WSL clip.exe,
# Wayland/X11). Over SSH there is no local tool that can reach the machine
# you're sitting at, so it falls back to an OSC 52 escape sequence: this asks
# the terminal emulator to set the clipboard, so piping to clip from a remote
# host copies to your local machine. Needs a terminal that honors OSC 52
# (kitty, iTerm2, recent tmux/screen, etc.).
_clip_osc52() {
  local b64 seq
  b64=$(base64 | tr -d '\n')
  seq="\033]52;c;${b64}\a"
  # tmux/screen need the sequence wrapped in their passthrough envelope.
  if [ -n "$TMUX" ]; then
    seq="\033Ptmux;\033${seq}\033\\"
  elif [ "${TERM%%-*}" = "screen" ]; then
    seq="\033P${seq}\033\\"
  fi
  # Write to the controlling terminal so a redirected stdout still reaches it.
  printf "%b" "$seq" > /dev/tty
}
clip() {
  if [ -n "$SSH_CONNECTION" ] || [ -n "$SSH_TTY" ]; then
    _clip_osc52
  elif type pbcopy &>/dev/null; then
    pbcopy                       # macOS
  elif type clip.exe &>/dev/null; then
    clip.exe                     # WSL
  elif type wl-copy &>/dev/null; then
    wl-copy                      # Wayland
  elif type xclip &>/dev/null; then
    xclip -selection clipboard   # X11
  elif type xsel &>/dev/null; then
    xsel --clipboard --input     # X11
  else
    _clip_osc52                  # last resort: terminal escape
  fi
}
