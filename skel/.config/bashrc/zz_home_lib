fi

# rust
if [ -r "$HOME/.cargo/env" ]; then
  . "$HOME/.cargo/env"
fi

if type nvim >&/dev/null; then
  alias vh='nvim .'
fi

if type tmux >&/dev/null; then
  # attach to the first session found on any named tmux server
  ta() {
    if [ "$TMUX" != '' ]; then
      echo "ta: Already in tmux"
      return 1
    fi
    tmux attach || tmux -L ws attach
  }

  # workspace manager
  th() {
    local _workspace_id _tmux_default _current_session
    _workspace_id="ws-$(printf %s "$PWD" | shasum | cut -c1-12)"
    if [ "$TMUX" == '' ]; then
      _tmux_default=''
    else
      case "$TMUX" in
        */default,*) _tmux_default='yes' ;;
        *) _tmux_default='no' ;;
      esac
    fi

    if [ "$_tmux_default" == '' ]; then
      tmux new-session -A -s "$_workspace_id"
    elif [ "$_tmux_default" != 'yes' ]; then
      if ! tmux -L default has-session -t "=$_workspace_id" 2>/dev/null; then
        if tmux -L default new-session -d -s "$_workspace_id" 2>/dev/null; then
          echo "Session created: $_workspace_id"
          echo "Not in default, unable to switch to session"
        else
          echo "Failed to create session: $_workspace_id"
          return 1
        fi
      else
        echo "Session already exists: $_workspace_id"
        echo "Not in default, unable to switch to session"
      fi
    else
      _current_session=$(tmux display-message -p '#{session_name}')
      if [ "$_current_session" = "$_workspace_id" ]; then
        echo "Already in session"
        return 0
      fi

      if ! tmux has-session -t "=$_workspace_id" 2>/dev/null; then
        if tmux new-session -d -s "$_workspace_id" 2>/dev/null; then
          echo "Session created: $_workspace_id"
          echo "Switching to session"
        else
          echo "Failed to create session: $_workspace_id"
          return 1
        fi
      fi
      tmux switch-client -t "=$_workspace_id"
    fi
  }

  # nested tmux helper
  tt() {
    local _ws_tt_id
    _ws_tt_id="ws-tt-$(printf %s "$PWD" | shasum | cut -c1-12)"
    tmux -L ws -f "$HOME/.config/tmux/tmux-inner.conf" new-session -A -s "$_ws_tt_id"
  }
fi

# clip: pipe stdin to the system clipboard, cross-platform and SSH-aware.
#
#   some-command | clip
#
# Local sessions use the native clipboard tool (macOS pbcopy, WSL clip.exe,
# Wayland/X11). Over SSH there is no local tool that can reach the machine
# you're sitting at, so it falls back to an OSC 52 escape sequence: this asks
# the terminal emulator to set the clipboard, so piping to clip from a remote
# host copies to your local machine. Needs a terminal that honors OSC 52
# (kitty, iTerm2, recent tmux/screen, etc.).
_clip_osc52() {
  local b64 seq
  b64=$(base64 | tr -d '\n')
  seq="\033]52;c;${b64}\a"
  # tmux/screen need the sequence wrapped in their passthrough envelope.
  if [ -n "$TMUX" ]; then
    seq="\033Ptmux;\033${seq}\033\\"
  elif [ "${TERM%%-*}" = "screen" ]; then
    seq="\033P${seq}\033\\"
  fi
  # Write to the controlling terminal so a redirected stdout still reaches it.
  printf "%b" "$seq" > /dev/tty
}
clip() {
  if [ -n "$SSH_CONNECTION" ] || [ -n "$SSH_TTY" ]; then
    _clip_osc52
  elif type pbcopy &>/dev/null; then
    pbcopy                       # macOS
  elif type clip.exe &>/dev/null; then
    clip.exe                     # WSL
  elif type wl-copy &>/dev/null; then
    wl-copy                      # Wayland
  elif type xclip &>/dev/null; then
    xclip -selection clipboard   # X11
  elif type xsel &>/dev/null; then
    xsel --clipboard --input     # X11
  else
    _clip_osc52                  # last resort: terminal escape
  fi
}
