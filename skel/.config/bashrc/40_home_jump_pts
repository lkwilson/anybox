# env jump points

# main env
function j() { cd "$ENV0"; }
# set main
function sj() { echo "export ENV0='$(pwd)'" >> ~/.config/bashrc/env; . ~/.config/bashrc/env; }

# mostly for bootstrapping, add to custom bashrc plugin
function sjr() { echo "CDPATH='.:$(pwd)'" >> ~/.config/bashrc/env; . ~/.config/bashrc/env; }

# got to tmux / vs code proj root
_term_start_dir="$PWD"
jw() {
  cd "$_term_start_dir"
}
