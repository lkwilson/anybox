if [ -r "/opt/homebrew/bin/brew" ]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
  export PATH="/opt/homebrew/opt/gnu-tar/libexec/gnubin:$PATH"
  export PATH="/opt/homebrew/opt/coreutils/libexec/gnubin:$PATH"
fi

if [ -r "/home/linuxbrew/.linuxbrew/bin/brew" ]; then
  eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv bash)"
fi

if [ "$TERM" == 'xterm-kitty' ]; then
  # if you get unrecognized terminal, run kitty ssh x, and it'll install it on
  # that machine
  export COLORTERM='truecolor'
elif [ "$TERM" == 'xterm-256color' ]; then
  # this is presumptutous, but since tahoe supports truecolor now, there are
  # really not many left that do not.
  export COLORTERM='truecolor'
elif [ "$TERM" == 'tmux-256color' ]; then
  # this is presumptutous, but since tahoe supports truecolor now, there are
  # really not many left that do not.
  export COLORTERM='truecolor'
fi
